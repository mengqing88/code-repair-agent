{
  "servers": [
    {
      "name": "context7",
      "transport": "streamable_http",
      "url": "https://mcp.context7.com/mcp",
      "allow_tools": [
        "resolve-library-id",
        "query-docs"
      ],
      "tool_policies": {
        "resolve-library-id": { "access": "read_only", "conflict_group": "library_lookup" },
        "query-docs": { "access": "read_only", "conflict_group": "documentation_search" }
      }
    },
    {
      "name": "github",
      "transport": "streamable_http",
      "url": "https://api.githubcopilot.com/mcp/readonly",
      "required_env": [
        "GITHUB_PERSONAL_ACCESS_TOKEN"
      ],
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}",
        "X-MCP-Readonly": "true",
        "X-MCP-Tools": "get_file_contents,search_code,search_repositories,issue_read,list_issues,search_issues,pull_request_read,list_pull_requests,list_commits,get_commit"
      },
      "allow_tools": [
        "get_file_contents",
        "search_code",
        "search_repositories",
        "issue_read",
        "list_issues",
        "search_issues",
        "pull_request_read",
        "list_pull_requests",
        "list_commits",
        "get_commit"
      ],
      "tool_policies": {
        "get_file_contents": { "access": "read_only" },
        "search_code": { "access": "read_only", "conflict_group": "github_search" },
        "search_repositories": { "access": "read_only", "conflict_group": "github_search" },
        "issue_read": { "access": "read_only" },
        "list_issues": { "access": "read_only" },
        "search_issues": { "access": "read_only", "conflict_group": "github_search" },
        "pull_request_read": { "access": "read_only" },
        "list_pull_requests": { "access": "read_only" },
        "list_commits": { "access": "read_only" },
        "get_commit": { "access": "read_only" }
      }
    },
    {
      "name": "sentry",
      "transport": "streamable_http",
      "url": "https://mcp.sentry.dev/mcp?skills=inspect",
      "required_env": [
        "SENTRY_AUTH_TOKEN"
      ],
      "headers": {
        "Authorization": "Sentry-Bearer ${SENTRY_AUTH_TOKEN}"
      },
      "allow_tools": [
        "find_organizations",
        "find_projects",
        "get_sentry_resource",
        "get_issue_details",
        "get_issue_activity",
        "get_issue_breadcrumbs",
        "get_event_stacktrace"
      ],
      "tool_policies": {
        "find_organizations": { "access": "read_only", "conflict_group": "sentry_context" },
        "find_projects": { "access": "read_only", "conflict_group": "sentry_context" },
        "get_sentry_resource": { "access": "read_only" },
        "get_issue_details": { "access": "read_only" },
        "get_issue_activity": { "access": "read_only" },
        "get_issue_breadcrumbs": { "access": "read_only" },
        "get_event_stacktrace": { "access": "read_only" }
      }
    }
  ]
}
