{
  "experiment_id": "model-upgrade-example",
  "purpose": "model",
  "evidence_kind": "live",
  "variants": {
    "baseline": {
      "version": "baseline-model-version",
      "configuration_ref": "baseline-config.json"
    },
    "candidate": {
      "version": "candidate-model-version",
      "configuration_ref": "candidate-config.json"
    }
  },
  "allowed_changes": [
    "/models",
    "/settings/values"
  ],
  "repetitions": 3,
  "order_seed": 29,
