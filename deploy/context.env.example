# Non-secret context-window settings. Merge into your local configuration as needed.
# Set this to the actual provider/model capacity; 128000 is a default, not detection.
CHAT_CONTEXT_WINDOW_TOKENS=128000
# Leave room for a response before deciding whether input needs compression.
# Must be 128..window/2; reduce this as well when choosing a smaller window.
CHAT_CONTEXT_OUTPUT_RESERVE_TOKENS=8192
# Prefer keeping these most recent complete tool exchanges verbatim (0..8).
CHAT_CONTEXT_KEEP_TOOL_ROUNDS=2
# Combined estimated token ceiling for all generated history summaries.
CHAT_CONTEXT_SUMMARY_TOKENS=2048
