# 合并这些非敏感配置到本机 .env；模型路径按实际下载位置填写。
# 安装：.venv\Scripts\python.exe -m pip install -e ".[rerank-onnx]"
CROSS_ENCODER_MODEL=F:/项目1/work/models/mmarco-mMiniLMv2
CROSS_ENCODER_BACKEND=onnx
CROSS_ENCODER_ONNX_PATH=F:/项目1/work/reranker-speed/reranker-fp32.onnx
CROSS_ENCODER_PROVIDER=DmlExecutionProvider
CROSS_ENCODER_THREADS=8
CROSS_ENCODER_CANDIDATES=10

# CPU 备选：CROSS_ENCODER_PROVIDER=CPUExecutionProvider，线程保持 8。
# 原模型：cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# 固定 revision：1427fd652930e4ba29e8149678df786c240d8825
# ONNX FP32 来自同一权重，单输出 Identity logits；不要直接混入多分类模型。
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=repair_experiences_qwen3vl8b
QDRANT_TIMEOUT_SECONDS=3
# 向量仍由现有 EMBEDDING_MODEL/EMBEDDING_BASE_URL/EMBEDDING_API_KEY 配置提供。
# 明确关闭任一可选功能时，对应的 MODEL 或 URL 设为 off。
